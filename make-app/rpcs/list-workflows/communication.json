{
  "url": "/v1/workflows",
  "method": "GET",
  "qs": {
    "page": 1,
    "limit": 100
  },
  "response": {
    "iterate": "{{body.data.data}}",
    "output": {
      "label": "{{ifempty(item.title, item.id)}}",
      "value": "{{item.id}}"
    },
    "limit": 500
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.data.meta.currentPage < body.data.meta.totalPages}}"
  }
}
