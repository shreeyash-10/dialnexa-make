{
  "url": "/v1/workflows/{{parameters.workflowId}}/leads",
  "method": "POST",
  "type": "multipart/form-data",
  "body": {
    "file": {
      "value": "{{parameters.fileData}}",
      "options": {
        "filename": "{{parameters.fileName}}"
      }
    }
  },
  "response": {
    "output": {
      "data": "{{body.data}}",
      "count": "{{body.count}}"
    }
  }
}
