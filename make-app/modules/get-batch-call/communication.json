{
  "url": "/v1/batch-calls/{{parameters.id}}",
  "method": "GET",
  "qs": {
    "status": "{{parameters.status}}",
    "sentiment": "{{parameters.sentiment}}",
    "page": 1,
    "limit": 200
  },
  "response": {
    "output": {
      "callLogs": "{{body.callLogs}}",
      "returnedCount": "{{length(body.callLogs)}}",
      "total": "{{body.total}}",
      "page": "{{body.page}}",
      "limit": "{{body.limit}}",
      "totalPages": "{{body.totalPages}}"
    }
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.page < body.totalPages}}"
  }
}
