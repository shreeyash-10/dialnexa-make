{
  "url": "/v1/batch-calls",
  "method": "GET",
  "qs": {
    "status": "{{parameters.status}}",
    "page": 1,
    "limit": 100
  },
  "response": {
    "iterate": "{{body}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{length(body) == 100}}"
  }
}
